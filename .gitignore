#///////////////////////////
# 抖音特效 Effect Creator
#///////////////////////////

# 编辑器缓存，可重建，且 lock 文件会造成无谓冲突
*/Library/
Library/
*-lock

# 素材暂存区：AI 出图的原始产物，动辄几十 MB，
# 挑选整理后的成品放在 Assets/数字/、Assets/背景/ 等目录才入库
*/Assets/temp.folder/
Assets/temp.folder/

# 节点图备份，编辑器自动生成
*.backup

#///////////////////////////
# 系统 / 编辑器
#///////////////////////////
.DS_Store
Thumbs.db
desktop.ini
*.log
.vscode/
.idea/

#///////////////////////////
# 凭据，绝不能提交
#///////////////////////////
*.key
*.pem
.env

#///////////////////////////
# 说明：以下必须入库，勿加忽略
#   *.dyehpj            —— 特效项目文件
#   Assets/ Graph/      —— 素材与节点图，项目主体
#   EffectSettings/     —— 特效设置
#   EventChains/        —— 事件链
#///////////////////////////
